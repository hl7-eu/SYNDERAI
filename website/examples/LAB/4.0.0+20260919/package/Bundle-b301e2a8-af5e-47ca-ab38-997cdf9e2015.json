            "text": {
              "status": "generated",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h3>HEM/BC</h3><table class=\"hl7__eu__lab__report\"><thead><tr><th>Test</th><th>02-MAY-1970</th><th>Reference&#xA0;Range</th><th>Unit</th></tr></thead><tbody><tr><td></td><td><strong>11.6 L</strong></td><td>12 - 16</td><td>g/dL</td></tr><tr><td></td><td><strong>34.8 L</strong></td><td>36 - 46</td><td>%</td></tr><tr><td></td><td>8.3</td><td>4 - 11</td><td>10*3/uL</td></tr><tr><td></td><td><strong>5.3 H</strong></td><td>3.8 - 5.2</td><td>10*6/uL</td></tr><tr><td></td><td>86.1</td><td>80 - 100</td><td>fL</td></tr><tr><td></td><td>29.1</td><td>27 - 33</td><td>pg</td></tr><tr><td></td><td>33.2</td><td>32 - 36</td><td>g/dL</td></tr><tr><td></td><td>42.9</td><td>36 - 48</td><td>fL</td></tr><tr><td></td><td>369.5</td><td>150 - 450</td><td>10*3/uL</td></tr><tr><td></td><td><strong>337.7 H</strong></td><td>9.4 - 12.3</td><td>fL</td></tr><tr><td></td><td>10.7</td><td>7.2 - 11.7</td><td>fL</td></tr></tbody></table></div>"
