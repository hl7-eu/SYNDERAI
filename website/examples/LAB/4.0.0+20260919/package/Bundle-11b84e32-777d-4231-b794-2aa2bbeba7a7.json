            "text": {
              "status": "generated",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h3>HEM/BC</h3><table class=\"hl7__eu__lab__report\"><thead><tr><th>Test</th><th>13-NOV-2015</th><th>Reference&#xA0;Range</th><th>Unit</th></tr></thead><tbody><tr><td></td><td><strong>11.9 L</strong></td><td>13.8 - 17.2</td><td>g/dL</td></tr><tr><td></td><td><strong>33.2 L</strong></td><td>37 - 49</td><td>%</td></tr><tr><td></td><td>8.4</td><td>4.5 - 11</td><td>10*3/uL</td></tr><tr><td></td><td>4.2</td><td>4.2 - 5.9</td><td>10*6/uL</td></tr><tr><td></td><td>86.9</td><td>80 - 100</td><td>fL</td></tr><tr><td></td><td>30.6</td><td>27 - 33</td><td>pg</td></tr><tr><td></td><td>35.7</td><td>32 - 36</td><td>g/dL</td></tr><tr><td></td><td>45.6</td><td>36 - 48</td><td>fL</td></tr><tr><td></td><td>448.3</td><td>150 - 450</td><td>10*3/uL</td></tr><tr><td></td><td><strong>513.4 H</strong></td><td>9.4 - 12.3</td><td>fL</td></tr><tr><td></td><td>9.6</td><td>7.2 - 11.2</td><td>fL</td></tr></tbody></table></div>"
