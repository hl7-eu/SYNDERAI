            "text": {
              "status": "generated",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h3>HEM/BC</h3><table class=\"hl7__eu__lab__report\"><thead><tr><th>Test</th><th>14-AUG-2023</th><th>Reference&#xA0;Range</th><th>Unit</th></tr></thead><tbody><tr><td></td><td><strong>11.5 L</strong></td><td>12 - 16</td><td>g/dL</td></tr><tr><td></td><td><strong>35.9 L</strong></td><td>36 - 46</td><td>%</td></tr><tr><td></td><td>5.4</td><td>4 - 11</td><td>10*3/uL</td></tr><tr><td></td><td>4.2</td><td>4.2 - 5.4</td><td>10*6/uL</td></tr><tr><td></td><td>87.6</td><td>80 - 100</td><td>fL</td></tr><tr><td></td><td>31.2</td><td>27 - 33</td><td>pg</td></tr><tr><td></td><td>34.9</td><td>32 - 36</td><td>g/dL</td></tr><tr><td></td><td>42.7</td><td>36 - 48</td><td>fL</td></tr><tr><td></td><td>310.3</td><td>150 - 450</td><td>10*3/uL</td></tr><tr><td></td><td><strong>173.5 H</strong></td><td>9.4 - 12.3</td><td>fL</td></tr><tr><td></td><td>9.5</td><td>6.4 - 11.2</td><td>fL</td></tr></tbody></table></div>"
