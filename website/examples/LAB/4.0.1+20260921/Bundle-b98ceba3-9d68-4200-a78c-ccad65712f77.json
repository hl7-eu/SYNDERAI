            "text": {
              "status": "generated",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h3>HEM/BC</h3><table class=\"hl7__eu__lab__report\"><thead><tr><th>Test</th><th>19-MAY-1987</th><th>Reference&#xA0;Range</th><th>Unit</th></tr></thead><tbody><tr><td></td><td><strong>21.7 H</strong></td><td>4 - 11</td><td>10*3/uL</td></tr><tr><td></td><td>4.4</td><td>4 - 5.2</td><td>10*6/uL</td></tr><tr><td></td><td>15.7</td><td>12 - 16</td><td>g/dL</td></tr><tr><td></td><td><strong>48.5 H</strong></td><td>36 - 46</td><td>%</td></tr><tr><td></td><td>85.0</td><td>80 - 100</td><td>fL</td></tr><tr><td></td><td>30.1</td><td>27 - 33</td><td>pg</td></tr><tr><td></td><td>33.7</td><td>32 - 36</td><td>g/dL</td></tr><tr><td></td><td>44.0</td><td>36 - 48</td><td>fL</td></tr><tr><td></td><td>433.1</td><td>150 - 450</td><td>10*3/uL</td></tr><tr><td></td><td><strong>365.8 H</strong></td><td>9.4 - 12.3</td><td>fL</td></tr><tr><td></td><td>9.4</td><td>6.4 - 11.2</td><td>fL</td></tr></tbody></table></div>"
