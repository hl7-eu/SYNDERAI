            "text": {
              "status": "generated",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h3>HEM/BC</h3><table class=\"hl7__eu__lab__report\"><thead><tr><th>Test</th><th>02-OCT-2003</th><th>Reference&#xA0;Range</th><th>Unit</th></tr></thead><tbody><tr><td></td><td><strong>11.0 L</strong></td><td>12 - 16</td><td>g/dL</td></tr><tr><td></td><td><strong>33.2 L</strong></td><td>36 - 46</td><td>%</td></tr><tr><td></td><td>6.3</td><td>4.5 - 11</td><td>10*3/uL</td></tr><tr><td></td><td><strong>5.4 H</strong></td><td>4 - 5.2</td><td>10*6/uL</td></tr><tr><td></td><td>89.4</td><td>80 - 100</td><td>fL</td></tr><tr><td></td><td>28.7</td><td>27 - 33</td><td>pg</td></tr><tr><td></td><td>33.9</td><td>32 - 36</td><td>g/dL</td></tr><tr><td></td><td>41.2</td><td>36 - 48</td><td>fL</td></tr><tr><td></td><td>365.0</td><td>150 - 450</td><td>10*3/uL</td></tr><tr><td></td><td><strong>475.6 H</strong></td><td>9.9 - 15.5</td><td>fL</td></tr><tr><td></td><td>9.8</td><td>7.2 - 11.1</td><td>fL</td></tr></tbody></table></div>"
