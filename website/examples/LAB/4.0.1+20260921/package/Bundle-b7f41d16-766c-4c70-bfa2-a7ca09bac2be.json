              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h3>HEM/BC</h3><table class=\"hl7__eu__lab__report\"><thead><tr><th>Test</th><th>01-JUN-2017</th><th>Reference&#xA0;Range</th><th>Unit</th></tr></thead><tbody><tr><td></td><td><strong>11.8 L</strong></td><td>12 - 16</td><td>g/dL</td></tr><tr><td></td><td><strong>35.1 L</strong></td><td>36 - 46</td><td>%</td></tr><tr><td></td><td>5.6</td><td>4 - 11</td><td>10*3/uL</td></tr><tr><td></td><td><strong>4.1 L</strong></td><td>4.2 - 5.4</td><td>10*6/uL</td></tr><tr><td></td><td>93.2</td><td>80 - 100</td><td>fL</td></tr><tr><td></td><td>29.1</td><td>27 - 33</td><td>pg</td></tr><tr><td></td><td>35.5</td><td>32 - 36</td><td>g/dL</td></tr><tr><td></td><td>45.2</td><td>36 - 48</td><td>fL</td></tr><tr><td></td><td>230.8</td><td>150 - 450</td><td>10*3/uL</td></tr><tr><td></td><td><strong>353.1 H</strong></td><td>9.4 - 12.3</td><td>fL</td></tr><tr><td></td><td>10.0</td><td>7.2 - 11.5</td><td>fL</td></tr></tbody></table></div>"
