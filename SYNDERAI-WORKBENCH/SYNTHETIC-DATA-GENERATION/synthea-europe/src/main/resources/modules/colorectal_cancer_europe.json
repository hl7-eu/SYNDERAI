        "low": 2,
        "high": 4,
        "unit": "hours"
      },
      "reason": "colorectal_cancer",
      "direct_transition": "End_CRC_Encounter"
    },
    "CRC_Surgery_Adjuvant": {
      "type": "Procedure",
      "remarks": [
        "Stage II: surgery. Adjuvant capecitabine in high-risk stage II."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "442285009",
          "display": "Excision of intestinal structure (procedure)"
        }
