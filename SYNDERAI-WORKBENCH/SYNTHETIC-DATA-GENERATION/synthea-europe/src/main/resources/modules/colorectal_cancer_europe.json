        {
          "distribution": 0.99892,
          "transition": "CRC_Annual_Delay"
        }
      ]
    },
    "CRC_Prob_65_69": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.00155,
          "transition": "CRC_Subsite_Branch"
        },
        {
          "distribution": 0.99845,
          "transition": "CRC_Annual_Delay"
        }
      ]
    },
    "CRC_Prob_70_74": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.00195,
          "transition": "CRC_Subsite_Branch"
        },
        {
          "distribution": 0.99805,
