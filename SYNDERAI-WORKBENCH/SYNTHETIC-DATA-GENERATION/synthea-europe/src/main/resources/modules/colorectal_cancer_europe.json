      },
      "direct_transition": "CRC_Annual_Check"
    },
    "CRC_Subsite_Branch": {
      "type": "Simple",
      "remarks": [
        "CRC anatomical subsite distribution (ECIS 2020):",
        "  Colon (right/transverse/left): ~55%",
        "  Sigmoid colon:                 ~25%",
        "  Rectum:                        ~20%"
      ],
      "distributed_transition": [
        {
          "distribution": 0.55,
          "transition": "Onset_Colon_Cancer"
        },
        {
          "distribution": 0.25,
          "transition": "Onset_Sigmoid_Cancer"
        },
        {
          "distribution": 0.2,
          "transition": "Onset_Rectal_Cancer"
        }
