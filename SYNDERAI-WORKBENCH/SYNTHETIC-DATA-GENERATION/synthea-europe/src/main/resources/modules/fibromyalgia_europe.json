      "assign_to_attribute": "fibromyalgia_prescription",
      "direct_transition": "End_Episode_Encounter",
      "remarks": [
        "Amitriptyline: EU guideline first-line for fibromyalgia (EAN/EULAR).",
        "Low-dose tricyclic antidepressant, widely used across Europe."
      ]
