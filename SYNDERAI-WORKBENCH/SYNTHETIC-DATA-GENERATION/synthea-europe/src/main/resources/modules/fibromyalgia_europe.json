    "Prescribe_Lyrica": {
      "type": "MedicationOrder",
      "assign_to_attribute": "fibromyalgia_prescription",
      "reason": "Fibromyalgia",
      "codes": [
        {
          "system": "RxNorm",
          "code": "861356",
          "display": "pregabalin 150 MG Oral Capsule"
        }
      ],
      "direct_transition": "End_Episode_Encounter",
      "remarks": [
        "Pregabalin 150mg: EMA-approved for fibromyalgia."
      ]
    },
    "Prescribe_Cymbalta": {
      "type": "MedicationOrder",
      "assign_to_attribute": "fibromyalgia_prescription",
      "reason": "Fibromyalgia",
      "codes": [
        {
          "system": "RxNorm",
          "code": "596926",
          "display": "duloxetine 20 MG Delayed Release Oral Capsule"
        }
      ],
      "direct_transition": "End_Episode_Encounter"
    },
    "End_Episode_Encounter": {
      "type": "EncounterEnd",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "fibromyalgia_prescription",
            "operator": "is not nil"
          },
          "transition": "Take_Prescription"
