    "Fibromyalgia_Episode": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "Fibromyalgia",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "390906007",
          "display": "Follow-up encounter (procedure)"
        }
      ],
      "complex_transition": [
        {
          "condition": {
            "condition_type": "Date",
            "operator": ">=",
            "year": 2000
