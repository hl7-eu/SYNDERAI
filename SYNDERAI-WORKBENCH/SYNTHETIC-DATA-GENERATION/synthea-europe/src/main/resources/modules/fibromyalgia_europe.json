{
  "name": "Fibromyalgia Europe",
  "remarks": [
    "EU-calibrated fibromyalgia module. Replaces fibromyalgia.json.",
    "EULAR 2017 / EAN fibromyalgia guidelines.",
    "",
    "CHANGES vs original US fibromyalgia.json:",
    "  Prevalence: 1.67% (US 7:1 ratio) → 2.7% (EU, F:M 2:1, EULAR 2017).",
    "    Female: 0.209% → 3.6%   Male: 1.461% → 1.8%",
    "  Removed milnacipran-brand (milnacipran): NOT EMA-approved for fibromyalgia (FDA only).",
    "  Removed opioid pathway: EULAR 2017 explicitly recommends AGAINST opioids.",
    "  Added amitriptyline 25mg: EU guideline first-line (EAN/EULAR).",
    "  Updated pregabalin dose: 100mg → 150mg (EMA-approved dose for fibromyalgia).",
    "  Episode encounter: emergency hospital → ambulatory (EU: outpatient management).",
    "",
    "EU medications: pregabalin 35%, duloxetine 35%, amitriptyline 30%."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "remarks": [
        "EU prevalence ~2.7% (EULAR 2017). F:M ratio ~2:1.",
        "Female: 3.6%  Male: 1.8%  Combined: 2.7%."
      ],
      "complex_transition": [
        {
          "condition": {
            "condition_type": "Gender",
            "gender": "M"
          },
          "distributions": [
            {
              "distribution": 0.018,
              "transition": "Delay_Until_Fibromyalgia"
            },
            {
              "distribution": 0.982,
              "transition": "Terminal"
            }
          ]
        },
        {
          "condition": {
            "condition_type": "Gender",
            "gender": "F"
          },
          "distributions": [
            {
              "distribution": 0.036,
              "transition": "Delay_Until_Fibromyalgia"
            },
            {
              "distribution": 0.964,
              "transition": "Terminal"
            }
          ]
        }
      ]
    },
    "Delay_Until_Fibromyalgia": {
      "type": "Delay",
      "range": {
        "low": 25,
        "high": 80,
        "unit": "years"
      },
      "direct_transition": "Fibromyalgia_Guard"
    },
    "Fibromyalgia_Guard": {
      "type": "Guard",
      "remarks": [
        "Fibromyalgia wasn't recognized as a disease by the AMA until 1987. It's ",
        "diagnosis is still somewhat controversial."
      ],
      "allow": {
        "condition_type": "Date",
        "operator": ">=",
        "year": 1987
      },
      "direct_transition": "Fibromyalgia"
    },
    "Fibromyalgia": {
      "type": "ConditionOnset",
      "remarks": [
        "======================================================================",
        " FIBROMYALGIA                                                         ",
        "======================================================================",
        "Source: http://www.cdc.gov/arthritis/basics/fibromyalgia.htm",
        "People with fibromyalgia have at least one hospitalization every 3 years.",
        "5.5M ambulatory care visits every year."
      ],
      "target_encounter": "Fibromyalgia_Diagnosis",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "95417003",
          "display": "Primary fibromyalgia syndrome (disorder)"
