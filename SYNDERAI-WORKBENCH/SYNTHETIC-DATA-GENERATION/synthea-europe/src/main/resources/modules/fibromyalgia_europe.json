    "Prescribe_Amitriptyline": {
      "type": "MedicationOrder",
      "reason": "Fibromyalgia",
      "codes": [
        {
          "system": "RxNorm",
          "code": "856783",
          "display": "amitriptyline hydrochloride 25 MG Oral Tablet"
