      },
      "direct_transition": "LC_Set_Stage_III"
    },
    "LC_Stage_IV_Treatment": {
      "type": "MedicationOrder",
      "remarks": [
        "Stage IV NSCLC: PD-L1 testing → pembrolizumab if PD-L1 >=50% (KEYNOTE-024).",
        "Otherwise platinum-doublet + immunotherapy (ESMO 2023).",
        "RxNorm 1860487: pembrolizumab 25 MG/ML Injectable Solution."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "1860487",
          "display": "pembrolizumab 25 MG/ML Injectable Solution"
        }
      ],
      "reason": "lung_cancer",
      "prescription": {
        "refills": 11,
        "as_needed": false,
        "instructions": "200mg IV q3w per immunotherapy protocol"
      },
      "direct_transition": "LC_Set_Stage_IV"
