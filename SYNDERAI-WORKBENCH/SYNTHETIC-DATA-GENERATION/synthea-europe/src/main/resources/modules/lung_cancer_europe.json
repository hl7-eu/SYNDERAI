          "code": "254632001",
          "display": "Small cell carcinoma of lung (disorder)"
        }
      ],
      "direct_transition": "LC_Staging_Encounter",
      "assign_to_attribute": "lung_cancer"
    },
    "LC_Staging_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "lung_cancer",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "11429006",
          "display": "Consultation (procedure)"
        }
      ],
      "direct_transition": "LC_CT_Scan"
    },
    "LC_CT_Scan": {
      "type": "ImagingStudy",
      "remarks": [
        "R4 fix: this state had a 'series' entry with no 'instances' list and no",
        "'procedure_code'. Synthea's State$ImagingStudy.duplicateInstances() calls",
        "s.instances.size() unconditionally, so every patient who reached this state",
        "threw a NullPointerException and was DISCARDED from the population entirely.",
        "That is why R3 contained no lung cancer of any kind despite a sound module:",
        "the cases were not missing their diagnosis, the patients were missing.",
        "It was the only malformed ImagingStudy state in the whole module tree.",
        "CT chest + abdomen + pelvis - standard EU staging workup."
      ],
      "procedure_code": {
        "system": "SNOMED-CT",
        "code": "418023006",
        "display": "Computed tomography of chest, abdomen and pelvis (procedure)"
      },
      "series": [
        {
          "body_site": {
            "system": "SNOMED-CT",
            "code": "732167000",
            "display": "Entire chest and abdomen and pelvis (body structure)"
          },
          "modality": {
            "system": "DICOM-DCM",
            "code": "CT",
            "display": "Computed Tomography"
          },
          "instances": [
            {
              "title": "CT Image Storage",
              "sop_class": {
                "system": "DICOM-SOP",
                "code": "1.2.840.10008.5.1.4.1.1.2",
                "display": "CT Image Storage"
              }
            }
          ]
        }
      ],
      "direct_transition": "LC_Stage_Branch"
    },
    "LC_Stage_Branch": {
      "type": "Simple",
      "remarks": [
        "Stage distribution at diagnosis (ECIS/Eurocare-5 2020):",
        "  Stage I:    ~15% (surgically resectable)",
        "  Stage II:   ~10%",
        "  Stage III:  ~25%",
        "  Stage IV:   ~50% (metastatic at presentation)"
      ],
      "distributed_transition": [
        {
          "distribution": 0.15,
          "transition": "LC_Stage_I_Treatment"
        },
        {
          "distribution": 0.1,
          "transition": "LC_Stage_II_Treatment"
        },
        {
          "distribution": 0.25,
          "transition": "LC_Stage_III_Treatment"
        },
        {
          "distribution": 0.5,
          "transition": "LC_Stage_IV_Treatment"
        }
      ]
    },
    "LC_Stage_I_Treatment": {
      "type": "Procedure",
      "remarks": [
        "ESMO 2023: surgical resection (lobectomy) is gold standard for stage I NSCLC."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "173171007",
          "display": "Lobectomy of lung (procedure)"
        }
      ],
      "duration": {
        "low": 2,
        "high": 4,
        "unit": "hours"
      },
      "reason": "lung_cancer",
      "direct_transition": "LC_Set_Stage_I"
    },
    "LC_Stage_II_Treatment": {
      "type": "Procedure",
      "codes": [
        {
          "system": "SNOMED-CT",
