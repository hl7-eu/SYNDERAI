        "low": 2,
        "high": 4,
        "unit": "hours"
      },
      "reason": "lung_cancer",
      "direct_transition": "LC_Set_Stage_II"
    },
    "LC_Stage_III_Treatment": {
      "type": "MedicationOrder",
      "remarks": [
        "Stage III: concurrent chemoradiotherapy + durvalumab consolidation (PACIFIC trial).",
        "Carboplatin/paclitaxel is common EU doublet chemotherapy.",
        "RxNorm 40048: carboplatin injection."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "40048",
          "display": "carboplatin 10 MG/ML Injectable Solution"
        }
      ],
      "reason": "lung_cancer",
      "prescription": {
        "refills": 5,
