      "encounter_class": "ambulatory",
      "reason": "lung_cancer",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "11429006",
          "display": "Consultation (procedure)"
        }
      ],
      "direct_transition": "LC_Outcomes_Check"
    },
    "LC_Outcomes_Check": {
      "type": "Simple",
      "remarks": [
        "5-year survival (Eurocare-5 / ECIS 2020): stage I ~60%, II ~35%, III ~15%,",
        "IV ~5%; overall European ~15%. Converted to a per-cycle death probability",
        "p = 1 - S5^(1/(5*4)) at 4 follow-up cycles a year.",
        "R4 sent 8% per cycle to Terminal. Terminal ends the MODULE, it does not kill",
        "the patient, so lung cancer survivors accumulated without limit: measured",
        "+588% against ECIS complete prevalence at 75+ while the 0-54 band, where few",
        "survivors have accumulated yet, was correct to +3%. A constant hazard is a",
        "simplification - real survival curves flatten after about five years - but a",
        "3%/yr residual after year five was tested and overshot 75+ by +70%."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "lc_stage",
            "operator": "==",
            "value": "I"
          },
          "transition": "LC_Mortality_I"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "lc_stage",
            "operator": "==",
            "value": "II"
          },
          "transition": "LC_Mortality_II"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "lc_stage",
            "operator": "==",
            "value": "III"
          },
          "transition": "LC_Mortality_III"
        },
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "lc_stage",
            "operator": "==",
            "value": "IV"
          },
          "transition": "LC_Mortality_IV"
        },
        {
          "transition": "LC_Mortality_III"
        }
      ]
    },
    "Terminal": {
      "type": "Terminal"
    },
    "LC_Set_Stage_I": {
      "type": "SetAttribute",
      "attribute": "lc_stage",
      "value": "I",
      "direct_transition": "End_LC_Encounter"
    },
    "LC_Set_Stage_II": {
