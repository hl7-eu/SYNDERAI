    "Toclizumab Trial": {
      "type": "SetAttribute",
      "attribute": "covid19_clinical_trial",
      "value": "toclizumab",
      "direct_transition": "Double Dose"
    },
    "Baricitinib Trial": {
      "type": "SetAttribute",
