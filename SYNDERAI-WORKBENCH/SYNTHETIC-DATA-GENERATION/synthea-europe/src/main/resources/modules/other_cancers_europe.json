            "quantity": 70,
            "unit": "years"
          },
          "transition": "Prob_60_69"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 80,
            "unit": "years"
          },
          "transition": "Prob_70_79"
        },
        {
          "transition": "Prob_80_plus"
        }
      ]
    },
    "Prob_25_39": {
