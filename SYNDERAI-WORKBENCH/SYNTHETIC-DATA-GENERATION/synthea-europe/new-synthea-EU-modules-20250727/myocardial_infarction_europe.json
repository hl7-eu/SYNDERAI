{
  "name": "Myocardial Infarction Europe",
  "remarks": [
    "EU-calibrated myocardial infarction module.",
    "REPLACES myocardial_infarction.json which fires for 0% of EU patients",
    "(reads 'mi_risk' attribute, default 0, set only by removed US CVD modules).",
    "",
    "Calibrated to ESC Atlas 2023 and EUROSTAT CVD data:",
    "  MI prevalence (history of): ~2-3% EU adults.",
    "  STEMI/NSTEMI annual incidence: ~0.2-0.4%/yr at 45-64, ~0.8%/yr at 65-74.",
    "",
    "Risk tiers (priority order):",
    "  High: ischemic_heart_disease == true (set by stable_ischemic_heart_disease_europe)",
    "  Medium: hypertension == true OR diabetes == true",
    "  Low: no major risk factors",
    "",
    "Rates per year:",
    "  IHD  45-64: 0.50%  |  65-74: 1.20%  |  75+: 2.50%",
    "  Med  45-64: 0.14%  |  65-74: 0.35%  |  75+: 0.70%",
    "  Low  45-64: 0.05%  |  65-74: 0.14%  |  75+: 0.28%",
    "",
    "Treatments: ESC STEMI 2017/NSTEMI 2020: dual antiplatelet + statin + beta-blocker.",
    "Sets attribute: myocardial_infarction = true.",
    "STEMI 55% / NSTEMI 45% split (ESC ACVC Registry 2023).",
    "",
    "PATCH (calibration round 2):",
    "  Added ConditionEnd states for STEMI/NSTEMI/MI after acute encounter.",
    "  Added chronic 'Old MI' (SNOMED 1755008) onset for problem list.",
    "  Restores correct acute/chronic semantics for EPS."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Age_Guard"
    },
    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 45,
        "unit": "years"
      },
      "direct_transition": "MI_Naive_Guard"
    },
    "MI_Naive_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Attribute",
        "attribute": "myocardial_infarction",
        "operator": "is nil"
      },
      "direct_transition": "Annual_MI_Delay"
    },
    "Annual_MI_Delay": {
      "type": "Delay",
      "exact": {
        "quantity": 1,
        "unit": "years"
      },
      "direct_transition": "MI_Risk_Check"
    },
    "MI_Risk_Check": {
      "type": "Simple",
      "remarks": [
        "Priority: IHD > hypertension/diabetes > low risk."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Attribute",
            "attribute": "ischemic_heart_disease",
            "operator": "==",
            "value": true
          },
          "transition": "MI_High_Risk_Age_Check"
        },
        {
          "condition": {
            "condition_type": "Or",
            "conditions": [
              {
                "condition_type": "Attribute",
                "attribute": "hypertension",
                "operator": "==",
                "value": true
              },
              {
                "condition_type": "Attribute",
                "attribute": "diabetes",
                "operator": "==",
                "value": true
              }
            ]
          },
          "transition": "MI_Med_Risk_Age_Check"
        },
        {
          "transition": "MI_Low_Risk_Age_Check"
        }
      ]
    },
    "MI_High_Risk_Age_Check": {
      "type": "Simple",
      "remarks": [
        "IHD age routing."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 65,
            "unit": "years"
          },
          "transition": "MI_Prob_High_45_64"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 75,
            "unit": "years"
          },
          "transition": "MI_Prob_High_65_74"
        },
        {
          "transition": "MI_Prob_High_75_plus"
        }
      ]
    },
    "MI_Med_Risk_Age_Check": {
      "type": "Simple",
      "remarks": [
        "Hypertension/DM age routing."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 65,
            "unit": "years"
          },
          "transition": "MI_Prob_Med_45_64"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 75,
            "unit": "years"
          },
          "transition": "MI_Prob_Med_65_74"
        },
        {
          "transition": "MI_Prob_Med_75_plus"
        }
      ]
    },
    "MI_Low_Risk_Age_Check": {
      "type": "Simple",
      "remarks": [
        "No major RF age routing."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 65,
            "unit": "years"
          },
          "transition": "MI_Prob_Low_45_64"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 75,
            "unit": "years"
          },
          "transition": "MI_Prob_Low_65_74"
        },
        {
          "transition": "MI_Prob_Low_75_plus"
        }
      ]
    },
    "MI_Prob_High_45_64": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 0.500%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.005,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.995,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_High_65_74": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 1.200%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.012,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.988,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_High_75_plus": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 2.500%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.025,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.975,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_Med_45_64": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 0.140%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.0014,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.9986,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_Med_65_74": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 0.350%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.0035,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.9965,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_Med_75_plus": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 0.700%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.007,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.993,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_Low_45_64": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 0.050%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.0005,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.9995,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_Low_65_74": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 0.140%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.0014,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.9986,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Prob_Low_75_plus": {
      "type": "Simple",
      "remarks": [
        "EU MI incidence: 0.280%/yr (ESC Atlas 2023)."
      ],
      "distributed_transition": [
        {
          "distribution": 0.0028,
          "transition": "MI_Onset"
        },
        {
          "distribution": 0.9972,
          "transition": "Annual_MI_Delay"
        }
      ]
    },
    "MI_Onset": {
      "type": "ConditionOnset",
      "assign_to_attribute": "myocardial_infarction",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "22298006",
          "display": "Myocardial infarction (disorder)"
        }
      ],
      "direct_transition": "Set_MI_Boolean"
    },
    "Set_MI_Boolean": {
      "type": "SetAttribute",
      "attribute": "myocardial_infarction",
      "value": true,
      "direct_transition": "MI_Type_Branch"
    },
    "MI_Type_Branch": {
      "type": "Simple",
      "remarks": [
        "ESC ACVC Registry 2023: STEMI ~55%, NSTEMI ~45% of all MIs in EU."
      ],
      "distributed_transition": [
        {
          "distribution": 0.55,
          "transition": "STEMI_Onset"
        },
        {
          "distribution": 0.45,
          "transition": "NSTEMI_Onset"
        }
      ]
    },
    "STEMI_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "401303003",
          "display": "Acute ST segment elevation myocardial infarction (disorder)"
        }
      ],
      "direct_transition": "MI_Emergency_Encounter"
    },
    "NSTEMI_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "401314000",
          "display": "Acute non-ST segment elevation myocardial infarction (disorder)"
        }
      ],
      "direct_transition": "MI_Emergency_Encounter"
    },
    "MI_Emergency_Encounter": {
      "type": "Encounter",
      "encounter_class": "emergency",
      "reason": "MI_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "50849002",
          "display": "Emergency room admission (procedure)"
        }
      ],
      "direct_transition": "MI_Outcome_Check"
    },
    "MI_Outcome_Check": {
      "type": "Simple",
      "remarks": [
        "ESC: 30-day MI mortality ~7-10%. Survivors proceed to secondary prevention."
      ],
      "distributed_transition": [
        {
          "distribution": 0.08,
          "transition": "MI_Death"
        },
        {
          "distribution": 0.92,
          "transition": "Prescribe_DAPT"
        }
      ]
    },
    "MI_Death": {
      "type": "Death",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "22298006",
          "display": "Myocardial infarction (disorder)"
        }
      ],
      "direct_transition": "Terminal"
    },
    "Prescribe_DAPT": {
      "type": "MedicationOrder",
      "reason": "MI_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "849574",
          "display": "clopidogrel 75 MG Oral Tablet"
        }
      ],
      "remarks": [
        "Dual antiplatelet: aspirin + clopidogrel (or ticagrelor). ESC STEMI/NSTEMI guidelines."
      ],
      "direct_transition": "Prescribe_Statin_MI"
    },
    "Prescribe_Statin_MI": {
      "type": "MedicationOrder",
      "reason": "MI_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "617311",
          "display": "atorvastatin 80 MG Oral Tablet"
        }
      ],
      "remarks": [
        "High-intensity statin 80mg mandatory post-MI (ESC guidelines)."
      ],
      "direct_transition": "Prescribe_ACE_MI"
    },
    "Prescribe_ACE_MI": {
      "type": "MedicationOrder",
      "reason": "MI_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "722131",
          "display": "ramipril 5 MG Oral Capsule"
        }
      ],
      "remarks": [
        "ACE inhibitor: ESC post-MI guideline, reduces remodelling. Ramipril EU first-line."
      ],
      "direct_transition": "End_MI_Encounter"
    },
    "End_MI_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "End_Acute_MI_Conditions"
    },
    "MI_Followup_Delay": {
      "type": "Delay",
      "range": {
        "low": 10,
        "high": 14,
        "unit": "months"
      },
      "direct_transition": "MI_Annual_Review"
    },
    "MI_Annual_Review": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "MI_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "390906007",
          "display": "Follow-up encounter (procedure)"
        }
      ],
      "direct_transition": "End_MI_Review"
    },
    "End_MI_Review": {
      "type": "EncounterEnd",
      "direct_transition": "MI_Followup_Delay"
    },
    "Terminal": {
      "type": "Terminal"
    },
    "End_Acute_MI_Conditions": {
      "type": "ConditionEnd",
      "condition_onset": "MI_Onset",
      "direct_transition": "End_STEMI_If_Present"
    },
    "End_STEMI_If_Present": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Active Condition",
            "codes": [
              {
                "system": "SNOMED-CT",
                "code": "401303003",
                "display": "Acute ST segment elevation myocardial infarction (disorder)"
              }
            ]
          },
          "transition": "End_STEMI_Condition"
        },
        {
          "transition": "End_NSTEMI_If_Present"
        }
      ]
    },
    "End_STEMI_Condition": {
      "type": "ConditionEnd",
      "condition_onset": "STEMI_Onset",
      "direct_transition": "End_NSTEMI_If_Present"
    },
    "End_NSTEMI_If_Present": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Active Condition",
            "codes": [
              {
                "system": "SNOMED-CT",
                "code": "401314000",
                "display": "Acute non-ST segment elevation myocardial infarction (disorder)"
              }
            ]
          },
          "transition": "End_NSTEMI_Condition"
        },
        {
          "transition": "Onset_Old_MI"
        }
      ]
    },
    "End_NSTEMI_Condition": {
      "type": "ConditionEnd",
      "condition_onset": "NSTEMI_Onset",
      "direct_transition": "Onset_Old_MI"
    },
    "Onset_Old_MI": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "1755008",
          "display": "Old myocardial infarction (disorder)"
        }
      ],
      "direct_transition": "MI_Followup_Delay",
      "remarks": [
        "Chronic problem-list entry for post-MI status.",
        "Stays clinicalStatus=active for the rest of life — replaces the",
        "previous behaviour of leaving STEMI/NSTEMI permanently active."
      ]
    }
  }
}