    "GAD7_Assessment": {
      "type": "Observation",
      "remarks": [
        "GAD-7: validated anxiety screening across European primary care.",
        "Score >=10: moderate-severe anxiety. LOINC 70274-6."
      ],
      "category": "survey",
      "unit": "score",
      "codes": [
        {
          "system": "LOINC",
          "code": "70274-6",
          "display": "GAD-7 Anxiety Severity Score"
