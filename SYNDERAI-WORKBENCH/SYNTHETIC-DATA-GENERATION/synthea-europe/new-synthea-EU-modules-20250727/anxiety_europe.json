{
  "name": "Anxiety Disorders (European Calibration)",
  "remarks": [
    "=======================================================================",
    "SYNTHEA MODULE: Anxiety Disorders \u2014 European Epidemiology Edition",
    "=======================================================================",
    "Calibrated against:",
    "  - ECNP/EBC 2023: Size and Burden of Mental Disorders in Europe",
    "  - ESEMeD: European Study of the Epidemiology of Mental Disorders",
    "  - WHO Mental Health Atlas Europe 2022",
    "  - NICE NG198 (2020): Generalised Anxiety Disorder",
    "  - WPA/ECNP European treatment guidelines for anxiety",
    "  - GBD 2019: Anxiety disorders \u2014 Europe",
    "",
    "Key calibration changes vs US default module:",
    "  - MODULE WAS GENERATING NEAR-ZERO RECORDS \u2014 completely rebuilt",
    "  - 12-month prevalence: ~6.5% (ECNP/EBC 2023)",
    "  - Covers: GAD (most common), panic disorder, social anxiety, specific phobia",
    "  - Female:male ratio ~2:1 (higher female prevalence modelled)",
    "  - First-line: SSRIs + CBT (European guideline consensus)",
    "  - Comorbid depression modelled (~50% co-occurrence \u2014 ESEMeD)",
    "",
    "European 12-month prevalence (ECNP/EBC 2023 / ESEMeD):",
    "  18-34 years : ~8.0%  (highest burden in young adults)",
    "  35-49 years : ~7.0%",
    "  50-64 years : ~6.0%",
    "  65-74 years : ~4.5%",
    "  75+  years  : ~3.5%"
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Age_Guard"
    },
    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 16,
        "unit": "years"
      },
      "direct_transition": "Anxiety_Naive_Guard"
    },
    "Delay_Onset_Window": {
      "type": "Delay",
      "range": {
        "low": 0,
        "high": 3,
        "unit": "years"
      },
      "direct_transition": "Anxiety_Annual_Check"
    },
    "Anxiety_Annual_Check": {
      "type": "Simple",
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 35,
            "unit": "years"
          },
          "transition": "Anxiety_Prob_16_34"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 50,
            "unit": "years"
          },
          "transition": "Anxiety_Prob_35_49"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 65,
            "unit": "years"
          },
          "transition": "Anxiety_Prob_50_64"
        },
        {
          "condition": {
            "condition_type": "Age",
            "operator": "<",
            "quantity": 75,
            "unit": "years"
          },
          "transition": "Anxiety_Prob_65_74"
        },
        {
          "transition": "Anxiety_Prob_75_plus"
        }
      ]
    },
    "Anxiety_Prob_16_34": {
      "type": "Simple",
      "remarks": [
        "Annual incidence ~0.9% to achieve ~8% 12-month prevalence. ECNP 2023."
      ],
      "distributed_transition": [
        {
          "distribution": 0.003,
          "transition": "Anxiety_Type_Branch"
        },
        {
          "distribution": 0.997,
          "transition": "Anxiety_Annual_Delay"
        }
      ]
    },
    "Anxiety_Prob_35_49": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.002667,
          "transition": "Anxiety_Type_Branch"
        },
        {
          "distribution": 0.997333,
          "transition": "Anxiety_Annual_Delay"
        }
      ]
    },
    "Anxiety_Prob_50_64": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.002333,
          "transition": "Anxiety_Type_Branch"
        },
        {
          "distribution": 0.997667,
          "transition": "Anxiety_Annual_Delay"
        }
      ]
    },
    "Anxiety_Prob_65_74": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.001667,
          "transition": "Anxiety_Type_Branch"
        },
        {
          "distribution": 0.998333,
          "transition": "Anxiety_Annual_Delay"
        }
      ]
    },
    "Anxiety_Prob_75_plus": {
      "type": "Simple",
      "distributed_transition": [
        {
          "distribution": 0.001333,
          "transition": "Anxiety_Type_Branch"
        },
        {
          "distribution": 0.998667,
          "transition": "Anxiety_Annual_Delay"
        }
