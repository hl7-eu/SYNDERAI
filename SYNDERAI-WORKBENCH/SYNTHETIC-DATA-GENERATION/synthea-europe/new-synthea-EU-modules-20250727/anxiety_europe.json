    },
    "Anxiety_Type_Branch": {
      "type": "Simple",
      "remarks": [
        "Distribution of anxiety subtypes from ECNP/EBC 2023 / ESEMeD:",
        "  GAD:             ~40% of anxiety cases",
        "  Panic disorder:  ~25%",
