      "direct_transition": "Anxiety_Treatment_Branch"
    },
    "Anxiety_Treatment_Branch": {
      "type": "Simple",
      "remarks": [
        "NICE NG198 / European guidelines: stepped care model.",
        "  Step 2 (mild): psychoeducation, low-intensity CBT, guided self-help",
        "  Step 3 (moderate): high-intensity CBT or SSRI/SNRI",
        "  Step 4 (severe): specialist MH services + combination therapy"
      ],
      "distributed_transition": [
        {
          "distribution": 0.35,
          "transition": "Anxiety_Psychotherapy"
        },
        {
          "distribution": 0.5,
          "transition": "Prescribe_SSRI_Anxiety"
        },
        {
          "distribution": 0.15,
          "transition": "Prescribe_SNRI_Anxiety"
        }
      ]
    },
    "Anxiety_Psychotherapy": {
      "type": "Procedure",
      "remarks": [
        "CBT: 12-16 sessions standard in European IAPT-equivalent services."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "228557008",
          "display": "Cognitive behavior therapy (regime/therapy)"
        }
      ],
      "duration": {
        "low": 45,
        "high": 60,
        "unit": "minutes"
      },
      "reason": "anxiety",
      "direct_transition": "End_Anxiety_Encounter"
    },
    "Prescribe_SSRI_Anxiety": {
      "type": "MedicationOrder",
      "remarks": [
        "Escitalopram 10mg OD \u2014 highest-ranked SSRI for anxiety (Cipriani 2018 meta-analysis).",
        "First-line across NICE NG198, DGPPN, and most European national guidelines.",
        "RxNorm 596926: escitalopram 10 MG Oral Tablet."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "596926",
          "display": "escitalopram 10 MG Oral Tablet"
        }
      ],
      "reason": "anxiety",
      "prescription": {
        "refills": 5,
        "as_needed": false,
        "instructions": "Take once daily. Effects may take 4-6 weeks. Do not stop abruptly."
      },
      "direct_transition": "End_Anxiety_Encounter"
    },
    "Prescribe_SNRI_Anxiety": {
      "type": "MedicationOrder",
      "remarks": [
        "Venlafaxine 75mg OD \u2014 SNRI option for GAD/panic, licensed across EU.",
        "Preferred when comorbid pain or fatigue present.",
        "RxNorm 898004: venlafaxine 75 MG Oral Tablet."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "898004",
          "display": "venlafaxine 75 MG Oral Tablet"
        }
      ],
      "reason": "anxiety",
      "prescription": {
        "refills": 5,
