{
  "name": "Breast Cancer (European Calibration)",
  "remarks": [
    "=======================================================================",
    "SYNTHEA MODULE: Breast Cancer \u2014 European Epidemiology Edition",
    "=======================================================================",
    "Calibrated against:",
    "  - ECIS / IARC GLOBOCAN 2020: Europe-specific incidence and survival",
    "  - ECDC Cancer Burden report 2022",
    "  - ESMO Clinical Practice Guidelines: Early and Advanced Breast Cancer 2023",
    "  - EU Council Recommendation on cancer screening (2022)",
    "  - Eurocare-6 survival study",
    "  - ECIBC: European Commission Initiative on Breast Cancer (screening)",
    "",
    "Key calibration data (ECIS/GLOBOCAN 2020 \u2014 Europe, female population):",
    "  Most common cancer in European women",
    "  Age-standardised incidence: ~92 per 100,000 women/year",
    "  Cumulative risk to age 75: ~7.4% (1 in 13 women)",
    "  5-year prevalence: ~1.4% of total population (both sexes)",
    "  5-year survival (Eurocare-6): ~87% \u2014 one of best in world",
    "  Mammography screening: 50-69 years in most EU countries",
    "",
    "Age-specific incidence per 100,000 women/year (ECIS 2020):",
    "  30-34 years :  ~12",
    "  35-39 years :  ~30",
    "  40-44 years :  ~75",
    "  45-49 years : ~130",
    "  50-54 years : ~165",
    "  55-59 years : ~175",
    "  60-64 years : ~185",
    "  65-69 years : ~190",
    "  70-74 years : ~185"
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Sex_Guard"
    },
    "Sex_Guard": {
      "type": "Guard",
      "remarks": [
        "Breast cancer occurs in women in ~99% of cases. Male BC modelled at ~1%."
      ],
      "allow": {
        "condition_type": "Or",
        "conditions": [
          {
            "condition_type": "Gender",
            "gender": "F"
          },
          {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Gender",
                "gender": "M"
              },
              {
                "condition_type": "Age",
                "operator": ">=",
                "quantity": 55,
                "unit": "years"
              }
            ]
          }
        ]
      },
      "direct_transition": "Age_Guard"
    },
    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 30,
        "unit": "years"
      },
      "direct_transition": "Mammography_Screening_Check"
    },
    "Mammography_Screening_Check": {
