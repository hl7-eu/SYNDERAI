      "remarks": [
        "EU screening: biennial mammography 50-69 years in most member states.",
        "ECIBC recommends extending to 45-74 (2022 update).",
        "Screening improves stage at detection \u2014 modelled in stage branch."
      ],
      "distributed_transition": [
        {
          "distribution": 0.7,
          "transition": "BC_Annual_Check"
        },
        {
          "distribution": 0.3,
          "transition": "Mammography_Procedure"
