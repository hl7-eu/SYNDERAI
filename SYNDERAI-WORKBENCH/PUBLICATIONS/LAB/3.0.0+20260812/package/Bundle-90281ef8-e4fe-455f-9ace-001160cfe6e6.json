            "text": {
              "status": "generated",
              "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h3>HEM/BC</h3><table class=\"hl7__eu__lab__report\"><thead><tr><th>Test</th><th>24-MAR-1962</th><th>Reference&#xA0;Range</th><th>Unit</th></tr></thead><tbody><tr><td></td><td><strong>10.6 L</strong></td><td>13.5 - 17.5</td><td>g/dL</td></tr><tr><td></td><td><strong>31.0 L</strong></td><td>39 - 50</td><td>%</td></tr><tr><td></td><td>5.6</td><td>4 - 11</td><td>10*3/uL</td></tr><tr><td></td><td>4.8</td><td>4.2 - 5.9</td><td>10*6/uL</td></tr><tr><td></td><td>89.4</td><td>80 - 100</td><td>fL</td></tr><tr><td></td><td>27.1</td><td>27 - 33</td><td>pg</td></tr><tr><td></td><td>34.5</td><td>32 - 36</td><td>g/dL</td></tr><tr><td></td><td>45.0</td><td>36 - 48</td><td>fL</td></tr><tr><td></td><td>272.6</td><td>150 - 450</td><td>10*3/uL</td></tr><tr><td></td><td><strong>236.6 H</strong></td><td>9.4 - 12.3</td><td>fL</td></tr><tr><td></td><td>10.5</td><td>7.2 - 11.5</td><td>fL</td></tr></tbody></table></div>"
