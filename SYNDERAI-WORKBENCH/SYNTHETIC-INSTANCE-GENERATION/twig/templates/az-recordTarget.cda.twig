%%CDA%% {# ── Section marker required by the CDA pre-processor ─────────────── #}

<recordTarget typeCode="RCT" contextControlCode="OP">
  <!-- patiënt: {{ patient.name }} uit {{ patient.postcode }} {{ patient.city }} -->
  <patientRole>
    <!-- BSN -->
    <id extension="{{ patient.bsn }}" root="2.16.840.1.113883.2.4.6.3"/>
    <addr use="HP">
{# --- #}
{% if patient.street is not empty %}
      <streetName>{{ patient.street }}</streetName>
{% if patient.housenumber is not empty %}
      <houseNumber>{{ patient.housenumber }}</houseNumber>
{% endif %}
{% if patient.additional is not empty %}
      <additionalLocator>{{ patient.additional }}</additionalLocator>
{% endif %}
{% endif %}
{# --- #}
      <postalCode>{{ patient.postcode }}</postalCode>
      <city>{{ patient.city }}</city>
      <country code="NL" codeSystem="1.0.3166.1.2.2">Nederland</country>
    </addr>
    <telecom use="HP" value="tel:{{ patient.phone }}"/>
    <patient classCode="PSN" determinerCode="INSTANCE">
      <name>
        <!-- {{ patient.name }} -->
{% for g in patient.given %}
        <given qualifier="BR">{{ g }}</given>
{% endfor %}
        <family qualifier="BR">XXX_{{ patient.family }}</family>
      </name>
{# --- #}
{% set genderMap = {
  'male':    'M',
  'female':  'F',
  'unknown': 'UN'
} %}
      <administrativeGenderCode codeSystem="2.16.840.1.113883.5.1" code="{{ genderMap[patient.gender]|default('code not found') }}"/>
      <birthTime value="{{ patient.birthdate|date('Ymd') }}"/>
{# --- #}
    </patient>
  </patientRole>
</recordTarget>